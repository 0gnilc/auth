{
  "name": "@vben/utils",
  "version": "1.0.0-rc.1",
  "homepage": "https://github.com/vbenjs/vue-vben-admin",
  "bugs": "https://github.com/vbenjs/vue-vben-admin/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vbenjs/vue-vben-admin.git",
    "directory": "packages/utils"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./decimal": {
      "types": "./src/decimal.ts",
      "default": "./src/decimal.ts"
    },
    "./cache": {
      "types": "./src/cache.ts",
      "default": "./src/cache.ts"
    },
    "./shared": {
      "types": "./src/shared.ts",
      "default": "./src/shared.ts"
    }
  },
  "dependencies": {
    "@vben-core/shared": "workspace:*",
    "@vben-core/typings": "workspace:*",
    "decimal.js": "catalog:",
    "vue-router": "catalog:"
  },
  "private": true
}
