<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.gnilc</groupId>
        <artifactId>gnilc-auth-parent</artifactId>
        <version>1.0.0-rc.1</version>
    </parent>

    <artifactId>gnilc-bootstrap</artifactId>

    <dependencies>
        <dependency>
            <groupId>com.gnilc</groupId>
            <artifactId>gnilc-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.gnilc</groupId>
            <artifactId>gnilc-test-support</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <directory>${maven.multiModuleProjectDirectory}/deploy/sql</directory>
                <targetPath>sql/schema</targetPath>
                <includes>
                    <include>01_rbac.sql</include>
                    <include>02_admin.sql</include>
                    <include>03_framework_permissions.sql</include>
                    <include>04_rbac_permissions.sql</include>
                    <include>05_admin_permissions.sql</include>
                    <include>06_i18n.sql</include>
                    <include>07_rbac_admin.sql</include>
                </includes>
            </testResource>
            <testResource>
                <directory>${maven.multiModuleProjectDirectory}/deploy/migrations</directory>
                <targetPath>sql/migrations</targetPath>
                <includes>
                    <include>history.sql</include>
                </includes>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.gnilc.bootstrap.AuthBootApplication</mainClass>
                    <classifier>exec</classifier>
                    <additionalProperties>
                        <channel>${build.channel}</channel>
                        <revision>${build.revision}</revision>
                    </additionalProperties>
                </configuration>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                            <goal>build-info</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
